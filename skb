    s = lines[0] + "\n\n" + new + (lines[1] if len(lines) > 1 else "")
    open(f, "w").write(s)
    print(f"  ✅ added v{v} section")
PYCH

  # ─── history.json ───
  echo "${BOLD}[5/7]${RESET} history.json"
  python3 - "$version" "$date" <<'PYH'
import json, sys, subprocess
