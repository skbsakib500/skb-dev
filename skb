        open(f, "w").write(s)
        print(f"  ✅ bumped {f}")
PYVER
  echo "  ✅ .skb/project.json"

  # ─── CHANGELOG ───
  echo "${BOLD}[4/7]${RESET} CHANGELOG"
  local date=$(date +%Y-%m-%d)
  python3 - "$version" "$date" <<'PYCH'
