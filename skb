_BRIDGE_DIR="$HOME/Life-OS/bridge"
_BRIDGE_OUT="$HOME/Life-OS/bridge/exports"

_lifos_bridge() {
  local action="$1"
  shift || true

  mkdir -p "$_BRIDGE_OUT"

  case "$action" in
