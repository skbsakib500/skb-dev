#!/data/data/com.termux/files/usr/bin/bash
# ═══════════════════════════════════════════════════════════
#  SKB DEV — Command Center v0.2
#  Unified development infrastructure for SKB projects
# ═══════════════════════════════════════════════════════════

SKB_ROOT="${SKB_ROOT:-$HOME}"
SKB_VERSION="0.2.0"

# ─── Colors ───
BOLD=$'\033[1m'
DIM=$'\033[2m'
CYAN=$'\033[36m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
RED=$'\033[31m'
BLUE=$'\033[34m'
RESET=$'\033[0m'

# ─── Utils ───
find_projects() {
  find "$SKB_ROOT" -maxdepth 2 -name ".skb" -type d 2>/dev/null \
    | xargs -n1 dirname 2>/dev/null | sort
}

jget() {
  # $1 = file, $2 = key (top-level string)
  grep -o "\"$2\": *\"[^\"]*\"" "$1" 2>/dev/null \
    | head -1 | cut -d'"' -f4
}

jget_num() {
  grep -o "\"$2\": *[0-9]*" "$1" 2>/dev/null \
    | head -1 | grep -o '[0-9]*$'
}

status_of() {
  # $1 = project dir
  cd "$1" 2>/dev/null || return
  if [ ! -d .git ]; then
    cd - >/dev/null
    echo "no-git"
    return
  fi
  local dirty=$(git status -s 2>/dev/null | wc -l)
  cd - >/dev/null
  [ "$dirty" -eq 0 ] && echo "clean" || echo "dirty:$dirty"
}

# ─── Commands ───
cmd_dashboard() {
  # Non-interactive: skb dashboard
  if [ "$1" = "--plain" ]; then
    _dashboard_render
    return
  fi

  while true; do
    clear
    _dashboard_render
    echo ""
    printf "${BOLD}${CYAN}  > ${RESET}"
    read -r choice

    case "$choice" in
      1|projects)  clear; cmd_projects; echo; read -p "  [enter] " ;;
      2|status)    clear; cmd_status; echo; read -p "  [enter] " ;;
      3|all)       clear; cmd_all; echo; read -p "  [enter] " ;;
      4|context)
        echo ""
        read -p "  project name: " pn
        clear; cmd_context "$pn"; echo; read -p "  [enter] " ;;
      5|todo)
        echo ""
        read -p "  project name: " pn
        clear; cmd_todo "$pn"; echo; read -p "  [enter] " ;;
      6|issues)
        echo ""
        read -p "  project name: " pn
        clear; cmd_issues "$pn"; echo; read -p "  [enter] " ;;
      7|log)
        echo ""
        read -p "  project name: " pn
        clear; cmd_log "$pn"; echo; read -p "  [enter] " ;;
      8|ai)
        echo ""
        read -p "  project name: " pn
        clear; cmd_context "$pn" --ai; echo; read -p "  [enter] " ;;
      9|doctor)    clear; _skb_doctor; echo; read -p "  [enter] " ;;
      0|q|exit)    clear; return ;;
      *) ;;
    esac
  done
}

_dashboard_render() {
  local count=$(find_projects | wc -l)
  local clean=0 dirty=0

  while read p; do
    [ -z "$p" ] && continue
    case "$(status_of "$p")" in
      clean) clean=$((clean+1)) ;;
      dirty:*) dirty=$((dirty+1)) ;;
    esac
  done < <(find_projects)

  echo "${BOLD}${CYAN}─────────────────────────────────────────────────${RESET}"
  echo "${BOLD}${CYAN}  SKB DEV ECOSYSTEM  v$SKB_VERSION${RESET}"
  echo "${BOLD}${CYAN}  Professional Command Hub${RESET}"
  echo "${BOLD}${CYAN}─────────────────────────────────────────────────${RESET}"
  printf "  Projects registered : ${GREEN}%s${RESET}
" "$count"
  printf "  Clean               : ${GREEN}%s${RESET}
" "$clean"
  printf "  With changes        : ${YELLOW}%s${RESET}
" "$dirty"
  echo "${BOLD}${CYAN}─────────────────────────────────────────────────${RESET}"
  echo "  ${BOLD}1${RESET}. Projects           ${DIM}table of all${RESET}"
  echo "  ${BOLD}2${RESET}. Status             ${DIM}current dir${RESET}"
  echo "  ${BOLD}3${RESET}. All                ${DIM}detailed${RESET}"
  echo "  ${BOLD}4${RESET}. Context            ${DIM}project snapshot${RESET}"
  echo "  ${BOLD}5${RESET}. TODO               ${DIM}open items${RESET}"
  echo "  ${BOLD}6${RESET}. Issues             ${DIM}known bugs${RESET}"
  echo "  ${BOLD}7${RESET}. Log                ${DIM}recent commits${RESET}"
  echo "  ${BOLD}8${RESET}. AI Context         ${DIM}--ai format${RESET}"
  echo "  ${BOLD}9${RESET}. Doctor             ${DIM}health scan${RESET}"
  echo "  ${BOLD}0${RESET}. Exit"
  echo "${BOLD}${CYAN}─────────────────────────────────────────────────${RESET}"
}

_skb_doctor() {
  echo "${BOLD}${CYAN}─── SKB Doctor — ecosystem health ───${RESET}"
  echo ""
  find_projects | while read p; do
    [ -z "$p" ] && continue
    local name=$(basename "$p")
    local ok=0
    local issues=""

    # Check .skb/ files
    for f in project state history config modules assets; do
      if [ -f "$p/.skb/$f.json" ]; then
        ok=$((ok+1))
      else
        issues="$issues missing:$f"
      fi
    done

    # Check schema
    if ! grep -q '"schema": *"skb/v1"' "$p/.skb/project.json" 2>/dev/null; then
      issues="$issues no-schema"
    fi

    # Check remote for secrets
    local url=$(cd "$p" && git remote get-url origin 2>/dev/null)
    if echo "$url" | grep -qE "ghp_|gho_|github_pat_"; then
      issues="$issues SECRET-IN-REMOTE"
    fi

    # Git clean
    local dirty=$(cd "$p" && git status -s 2>/dev/null | wc -l)
    if [ "$dirty" -gt 0 ]; then
      issues="$issues dirty:$dirty"
    fi

    if [ -z "$issues" ]; then
      printf "  ${GREEN}✅${RESET} %-15s 6/6 files · clean · safe
" "$name"
    else
      printf "  ${YELLOW}⚠️${RESET}  %-15s %s/6 files%s
" "$name" "$ok" "$issues"
    fi
  done
}

cmd_projects() {
  echo "${BOLD}${CYAN}📦 Registered SKB Projects${RESET}"
  echo ""
  printf "${DIM}  %-20s %-12s %-10s %s${RESET}\n" "NAME" "VERSION" "STATUS" "TYPE"
  printf "${DIM}  %-20s %-12s %-10s %s${RESET}\n" "────" "───────" "──────" "────"
  find_projects | while read p; do
    local name=$(basename "$p")
    local ver=$(jget "$p/.skb/project.json" "version")
    local type=$(jget "$p/.skb/project.json" "type")
    local st=$(status_of "$p")
    local st_icon
    case "$st" in
      clean)      st_icon="${GREEN}✅ clean${RESET}" ;;
      dirty:*)    st_icon="${YELLOW}⚠️  ${st#dirty:} new${RESET}" ;;
      *)          st_icon="${DIM}—${RESET}" ;;
    esac
    printf "  %-20s %-12s %-22s %s\n" "$name" "${ver:-—}" "$st_icon" "${type:-—}"
  done
}

cmd_status() {
  local p="$(pwd)"
  if [ ! -d "$p/.skb" ]; then
    echo "${RED}⚠️  Not an SKB project (no .skb/ folder)${RESET}"
    return 1
  fi
  local name=$(basename "$p")
  echo "${BOLD}${CYAN}════════════════════════════════════════════════${RESET}"
  echo "${BOLD}${CYAN}  $name — Project Status${RESET}"
  echo "${BOLD}${CYAN}════════════════════════════════════════════════${RESET}"
  echo ""
  echo "${BOLD}Identity:${RESET}"
  echo "  ID:      $(jget .skb/project.json project_id)"
  echo "  Type:    $(jget .skb/project.json type)"
  echo "  Version: $(jget .skb/project.json version)"
  echo "  Status:  $(jget .skb/project.json status)"
  echo ""
  echo "${BOLD}Repository:${RESET}"
  echo "  Remote:  $(git remote get-url origin 2>/dev/null | sed 's|gh[pous]_[A-Za-z0-9_]*|<REDACTED>|g')"
  echo "  Branch:  $(git branch --show-current 2>/dev/null)"
  echo "  Head:    $(git log --oneline -1 2>/dev/null | cut -c1-60)"
  echo "  State:   $(status_of "$p")"
  echo ""
  echo "${BOLD}Current Focus:${RESET}"
  echo "  $(jget .skb/state.json current_focus)"
  echo ""
  echo "${BOLD}Next:${RESET}"
  echo "  $(jget .skb/state.json next_focus)"
  echo ""
  echo "${BOLD}Open Issues:${RESET}"
  local issues=$(grep -o '"[^"]*"' .skb/state.json | grep '^"KI-' | tr -d '"' | paste -sd ' ' -)
  echo "  ${issues:-none}"
  echo ""
  echo "${DIM}Docs: $(ls *.md 2>/dev/null | tr '\n' ' ')${RESET}"
}

cmd_open() {
  local name="$1"
  [ -z "$name" ] && { echo "${RED}usage: skb open <project>${RESET}"; return 1; }
  local p
  p=$(find_projects | grep "/$name$" | head -1)
  [ -z "$p" ] && p=$(find_projects | grep -i "/$name" | head -1)
  [ -z "$p" ] && { echo "${RED}project not found: $name${RESET}"; return 1; }
  local name2=$(basename "$p")
  echo "${BOLD}${CYAN}═══ $name2 ═══${RESET}"
  [ -f "$p/PROJECT.md" ] && head -40 "$p/PROJECT.md"
  echo ""
  echo "${DIM}cd $p${RESET}"
}

cmd_all() {
  echo "${BOLD}${CYAN}═══ All Projects ═══${RESET}"
  echo ""
  find_projects | while read p; do
    local name=$(basename "$p")
    local ver=$(jget "$p/.skb/project.json" "version")
    local focus=$(jget "$p/.skb/state.json" current_focus)
    local st=$(status_of "$p")
    echo "${BOLD}📦 $name${RESET}  v$ver  [$st]"
    echo "   ${DIM}focus: ${focus:-—}${RESET}"
    cd "$p"
    git log --oneline -2 2>/dev/null | sed 's/^/   · /'
    cd - >/dev/null
    echo ""
  done
}

cmd_log() {
  local name="$1"
  [ -z "$name" ] && name="$(basename $(pwd))"
  local p
  p=$(find_projects | grep "/$name$" | head -1)
  [ -z "$p" ] && { echo "${RED}project not found: $name${RESET}"; return 1; }
  echo "${BOLD}${CYAN}═══ $name — recent commits ═══${RESET}"
  cd "$p"
  git log --oneline -10 | sed 's/^/  /'
  cd - >/dev/null
}

cmd_todo() {
  local name="$1"
  [ -z "$name" ] && name="$(basename $(pwd))"
  local p
  p=$(find_projects | grep "/$name$" | head -1)
  [ -z "$p" ] && { echo "${RED}project not found: $name${RESET}"; return 1; }
  echo "${BOLD}${CYAN}═══ $name — open TODOs ═══${RESET}"
  grep "^- \[ \]" "$p/TODO.md" 2>/dev/null | head -20 | sed 's/^/  /'
}

cmd_issues() {
  local name="$1"
  [ -z "$name" ] && name="$(basename $(pwd))"
  local p
  p=$(find_projects | grep "/$name$" | head -1)
  [ -z "$p" ] && { echo "${RED}project not found: $name${RESET}"; return 1; }
  echo "${BOLD}${CYAN}═══ $name — open issues ═══${RESET}"
  grep "^## 🟠\|^## 🟡\|^## 🟢\|^## 🔴" "$p/KNOWN-ISSUES.md" 2>/dev/null | sed 's/^/  /'
}

cmd_cd() {
  local name="$1"
  local p
  p=$(find_projects | grep "/$name$" | head -1)
  [ -z "$p" ] && { echo "${RED}project not found: $name${RESET}"; return 1; }
  echo "cd $p"
}

cmd_context() {
  local name="$1"
  local mode="$2"

  if [ -z "$name" ]; then
    name="$(basename $(pwd))"
  fi

  local p
  p=$(find_projects | grep "/$name$" | head -1)
  [ -z "$p" ] && p=$(find_projects | grep -i "/$name" | head -1)
  [ -z "$p" ] && { echo "${RED}project not found: $name${RESET}"; return 1; }

  if [ ! -d "$p/.skb" ]; then
    echo "${RED}no .skb/ in $p${RESET}"
    return 1
  fi

  python3 - "$p" "$mode" <<'PYCTX'
import json, os, sys, subprocess
from collections import Counter

proj_path = sys.argv[1]
mode = sys.argv[2] if len(sys.argv) > 2 else ""

def load(f):
    p = os.path.join(proj_path, ".skb", f)
    if not os.path.exists(p): return {}
    try:
        with open(p) as fh: return json.load(fh)
    except Exception: return {}

proj = load("project.json")
state = load("state.json")
history = load("history.json")
mods = load("modules.json")
assets = load("assets.json")

def sh(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, cwd=proj_path, stderr=subprocess.DEVNULL).decode().strip()
    except Exception:
        return ""

git_head = sh("git log --oneline -1")
git_branch = sh("git branch --show-current")
git_clean = "clean" if not sh("git status -s") else "dirty"

mod_list = mods.get("modules", [])
asset_list = assets.get("assets", [])
mod_types = Counter(m.get("type", "?") for m in mod_list)
recent = history.get("releases", [])[-3:][::-1]

if mode == "--json":
    out = {
        "project": proj,
        "state": state,
        "history_recent": recent,
        "modules_count": len(mod_list),
        "assets_count": len(asset_list),
        "module_types": dict(mod_types),
        "git": {"head": git_head, "branch": git_branch, "clean": git_clean == "clean"}
    }
    print(json.dumps(out, indent=2))

elif mode == "--ai":
    print("=== SKB PROJECT CONTEXT ===")
    print(f"You are working on {proj.get('name','?')} (v{proj.get('version','?')}).")
    print()
    print("ARCHITECTURE")
    print(f"  Type: {proj.get('type','?')}")
    print(f"  Stack: {', '.join(proj.get('stack', []))}")
    print()
    print("CURRENT STATE")
    print(f"  Focus: {state.get('current_focus','?')}")
    print(f"  Next: {state.get('next_focus','?')}")
    print(f"  Progress: {state.get('progress', 0)}%")
    print(f"  Git: {git_branch} · {git_clean} · {(git_head[:7] if git_head else '?')}")
    print()
    print(f"MODULES ({len(mod_list)})")
    for t, n in sorted(mod_types.items(), key=lambda x: -x[1]):
        print(f"  {t}: {n}")
    print()
    print("OPEN ISSUES")
    issues = state.get("known_issues_open", [])
    print(f"  {', '.join(issues) if issues else 'none'}")
    print()
    print("RECENT RELEASES")
    for r in recent:
        hl = r.get("highlights", [])
        first = hl[0] if hl else ""
        print(f"  {r.get('version','?')} ({r.get('date','?')}): {first}")
    print()
    print("=== END CONTEXT ===")

else:
    W = 50
    print("\u2554" + "\u2550"*W + "\u2557")
    print("\u2551  SKB PROJECT CONTEXT" + " "*(W-22) + "\u2551")
    print("\u255a" + "\u2550"*W + "\u255d")
    print()
    print(f"  PROJECT     {proj.get('name','?')}")
    print(f"  ID          {proj.get('id','?')}")
    print(f"  VERSION     {proj.get('version','?')}")
    print(f"  TYPE        {proj.get('type','?')}")
    print(f"  STATUS      {proj.get('status','?')}")
    print()
    print(f"  GIT         {git_branch} · {git_clean}")
    print(f"  HEAD        {git_head[:60] if git_head else '?'}")
    print(f"  FOCUS       {state.get('current_focus','?')}")
    print(f"  NEXT        {state.get('next_focus','?')}")
    print(f"  PROGRESS    {state.get('progress', 0)}%")
    print()
    print(f"  MODULES     {len(mod_list)}")
    for t, n in sorted(mod_types.items(), key=lambda x: -x[1]):
        print(f"    {t:<10} {n}")
    print(f"  ASSETS      {len(asset_list)}")
    issues = state.get("known_issues_open", [])
    print(f"  ISSUES      {len(issues)} open")
    if issues:
        print(f"              {' '.join(issues)}")
    print()
    print("  RECENT RELEASES:")
    for r in recent:
        hl = r.get("highlights", [])
        first = (hl[0] if hl else "")[:55]
        print(f"    {r.get('version','?'):<8} {r.get('date','?')}  {first}")
    print()
    stack = proj.get("stack", [])
    print("  STACK:")
    print(f"    {' · '.join(stack)}")
PYCTX
}

# ─── SECURITY MODULE (Phase 5) ───

# Scan a single project for secrets
cmd_scan() {
  local name="$1"
  local do_all="$2"

  if [ "$name" = "--all" ] || [ "$do_all" = "--all" ]; then
    local total=0
    local found=0
    echo "${BOLD}${CYAN}═══ SECRET SCAN — ALL PROJECTS ═══${RESET}"
    echo ""
    find_projects | while read p; do
      [ -z "$p" ] && continue
      _scan_project "$p"
    done
    return
  fi

  local p
  if [ -z "$name" ]; then
    p="$(pwd)"
  else
    p=$(find_projects | grep "/$name$" | head -1)
    [ -z "$p" ] && p=$(find_projects | grep -i "/$name" | head -1)
  fi

  [ -z "$p" ] && { echo "${RED}project not found${RESET}"; return 1; }
  _scan_project "$p"
}

_scan_project() {
  local p="$1"
  local name=$(basename "$p")
  local issues=0

  echo "${BOLD}${CYAN}─── $name ───${RESET}"

  # 1. Remote URL check (no cd)
  local url
  url=$(git -C "$p" remote get-url origin 2>/dev/null)
  if echo "$url" | grep -qE "ghp_|gho_|github_pat_|glpat-"; then
    echo "  ${RED}🔴 SECRET IN REMOTE URL${RESET}"
    issues=$((issues+1))
  else
    echo "  ${GREEN}✅${RESET} remote clean"
  fi

  # 2. Tracked files — git grep (C-based, fast, low memory)
  local hits
  hits=$(git -C "$p" grep -l -I -E \
    "ghp_[A-Za-z0-9]{30,}|gho_[A-Za-z0-9]{30,}|sk-[A-Za-z0-9]{30,}|AIza[A-Za-z0-9_-]{30,}|gsk_[A-Za-z0-9]{30,}" \
    2>/dev/null | head -5)
  if [ -n "$hits" ]; then
    echo "  ${RED}🔴 secrets in:${RESET}"
    echo "$hits" | sed 's/^/      /'
    issues=$((issues+1))
  else
    echo "  ${GREEN}✅${RESET} tracked files clean"
  fi

  # 3. .env safety
  if [ -f "$p/.env" ]; then
    if grep -q "\.env" "$p/.gitignore" 2>/dev/null; then
      echo "  ${GREEN}✅${RESET} .env present + ignored"
    else
      echo "  ${YELLOW}⚠️${RESET}  .env present, not in .gitignore"
      issues=$((issues+1))
    fi
  fi

  # 4. .git/config secret
  if grep -qE "ghp_|gho_|github_pat_" "$p/.git/config" 2>/dev/null; then
    echo "  ${RED}🔴 secret in .git/config${RESET}"
    issues=$((issues+1))
  fi

  if [ "$issues" -eq 0 ]; then
    echo "  ${GREEN}✅ CLEAN${RESET}"
  else
    echo "  ${RED}⚠️  $issues issue(s)${RESET}"
  fi
  echo ""
}

# Audit project rules
cmd_audit() {
  local name="$1"
  local p
  if [ -z "$name" ]; then
    p="$(pwd)"
  else
    p=$(find_projects | grep "/$name$" | head -1)
    [ -z "$p" ] && p=$(find_projects | grep -i "/$name" | head -1)
  fi

  [ -z "$p" ] && { echo "${RED}project not found${RESET}"; return 1; }

  local proj_name=$(basename "$p")
  echo "${BOLD}${CYAN}═══ AUDIT — $proj_name ═══${RESET}"
  echo ""

  cd "$p"

  # Rule checks from .skb/config.json
  local cfg=".skb/config.json"
  if [ ! -f "$cfg" ]; then
    echo "  ${YELLOW}⚠️  no config.json${RESET}"
  else
    echo "  ${BOLD}Config rules:${RESET}"
    python3 - "$cfg" <<'PYAUDIT'
import json, sys
c = json.load(open(sys.argv[1]))
sec = c.get("security", {})
for k, v in sec.items():
    mark = "✅" if v is not True else "✅"
    print(f"    {mark} {k}: {v}")
PYAUDIT
  fi

  echo ""
  echo "  ${BOLD}Checks:${RESET}"

  # .env
  [ -f ".env" ] && echo "    ⚠️  .env present (must stay untracked)" || echo "    ✅ no .env"
  git ls-files 2>/dev/null | grep -q "^\.env$" && echo "    🔴 .env IS TRACKED" || echo "    ✅ .env untracked"

  # Remote
  url=$(git remote get-url origin 2>/dev/null)
  echo "$url" | grep -qE "ghp_|gho_" && echo "    🔴 secret in remote" || echo "    ✅ remote clean"

  # Gitignore
  if [ -f ".gitignore" ]; then
    echo "    ✅ .gitignore present"
  else
    echo "    ⚠️  no .gitignore"
  fi

  # Schema
  grep -q '"schema": *"skb/v1"' .skb/project.json 2>/dev/null \
    && echo "    ✅ schema skb/v1" \
    || echo "    ⚠️  no skb/v1 schema"

  cd - >/dev/null 2>&1
}

# Guard — install pre-commit hook
cmd_guard() {
  local action="$1"
  local p="${2:-$(pwd)}"

  case "$action" in
    install)
      if [ ! -d "$p/.git" ]; then
        echo "${RED}not a git repo: $p${RESET}"
        return 1
      fi
      local hook="$p/.git/hooks/pre-commit"
      cat > "$hook" <<'HOOKEOF'
#!/data/data/com.termux/files/usr/bin/bash
# SKB-Dev guard — pre-commit secret scan
PATTERNS="ghp_[A-Za-z0-9]{30,}|gho_[A-Za-z0-9]{30,}|sk-[A-Za-z0-9]{30,}|AIza[A-Za-z0-9_-]{30,}|gsk_[A-Za-z0-9]{30,}"
HITS=$(git diff --cached --name-only | while read f; do
  [ -f "$f" ] || continue
  grep -lE "$PATTERNS" "$f" 2>/dev/null
done)
if [ -n "$HITS" ]; then
  echo "🔴 SKB-Guard: secret pattern detected in staged files:"
  echo "$HITS"
  echo ""
  echo "Commit blocked. Revoke + remove secret before retrying."
  exit 1
fi
exit 0
HOOKEOF
      chmod +x "$hook"
      echo "${GREEN}✅ SKB-Guard installed in $(basename $p)/.git/hooks/pre-commit${RESET}"
      ;;
    uninstall)
      rm -f "$p/.git/hooks/pre-commit"
      echo "${GREEN}✅ guard removed${RESET}"
      ;;
    status)
      if [ -x "$p/.git/hooks/pre-commit" ]; then
        echo "${GREEN}✅ guard active${RESET}"
      else
        echo "${YELLOW}⚠️  guard not installed${RESET}"
      fi
      ;;
    *)
      echo "usage: skb guard [install|uninstall|status] [project]"
      ;;
  esac
}

# ─── RELEASE ENGINE (Phase 6) ───

cmd_release() {
  local name="$1"
  local version="$2"

  if [ -z "$name" ] || [ -z "$version" ]; then
    echo "usage: skb release <project> <version>"
    echo "  e.g. skb release SKB-Player 2.5.0"
    return 1
  fi

  local p
  p=$(find_projects | grep "/$name$" | head -1)
  [ -z "$p" ] && p=$(find_projects | grep -i "/$name" | head -1)
  [ -z "$p" ] && { echo "${RED}project not found: $name${RESET}"; return 1; }

  local proj_name=$(basename "$p")
