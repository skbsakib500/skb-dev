    printf "  Continue anyway? [y/N] "
    read -r ans
    case "$ans" in y|Y|yes) ;; *) echo "  ${RED}aborted${RESET}"; return 1 ;; esac
  else
    echo "  ✅ clean"
  fi

  # ─── Bump version ───
  echo "${BOLD}[3/7]${RESET} Bump version"
  python3 - "$version" <<'PYVER'
