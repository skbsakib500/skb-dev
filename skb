    validate)  _bridge_validate "$@" ;;
    diff)      _bridge_diff "$@" ;;
    import)    _bridge_import "$@" ;;
    *)
      echo "usage: skb lifos bridge <action>"
      echo ""
      echo "  export <source> [--out file]"
      echo "  validate <file.json>"
